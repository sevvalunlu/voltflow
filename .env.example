# Bu dosyayi ".env" adiyla kopyalayip kendi degerlerinizi yazin.
# Degerleri tirnak icine almayin.

# MySQL baglantisi
DB_USERNAME=root
DB_PASSWORD=

# (Opsiyonel) varsayilan: jdbc:mysql://localhost:3306/voltflowdb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# DB_URL=

# Ilk acilista olusturulacak demo kullanici sifreleri.
# Bos birakilirsa ilgili kullanici olusturulmaz.
# Kullanici adlari: admin ve personel
VOLTFLOW_ADMIN_PASSWORD=
VOLTFLOW_EMPLOYEE_PASSWORD=
